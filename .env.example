REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ufc-prediction-rag by u/YOUR_REDDIT_USERNAME

# Dedicated burner account only -- never a personal X account (real risk of
# account suspension for scraping activity via twikit).
X_USERNAME=
X_EMAIL=
X_PASSWORD=

# Local Postgres+pgvector (Docker). Fine as plain defaults for local dev --
# swap for real RDS credentials via .env when deploying, never commit real ones.
POSTGRES_USER=ufc_app
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=ufc_prediction
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
